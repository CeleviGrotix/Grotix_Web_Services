{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Enabled": false,
    "AlertTriggeredQueueName": "irrigation.alert.triggered",
    "AlertTriggeredRoutingKey": "alert.triggered",
    "IrrigationCompletedRoutingKey": "irrigation.completed"
  },
  "WeatherForecast": {
    "BaseUrl": "https://api.open-meteo.com/v1/forecast",
    "Latitude": -12.0464,
    "Longitude": -77.0428,
    "RainMmThreshold": 0.5,
    "RainProbabilityThresholdPercent": 50,
    "HumidityDeficitThresholdPercent": 5.0
  }
}
