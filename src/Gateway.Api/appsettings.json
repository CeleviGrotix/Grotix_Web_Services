{
  "TokenSettings": {
    "Secret": "EstaEsUnaClaveSuperSecretaParaGrotix2024"
  },
  "ReverseProxy": {
    "Routes": {
      "health-ready-telemetry": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/ready/telemetry"
        }
      },
      "health-ready-core": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/ready/core"
        }
      },
      "health-live": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/live"
        }
      },
      "profiles-new": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/profiles/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/profiles" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "cultivation-new": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/cultivation/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1/cultivation" },
          { "PathPrefix": "/api/v1" }
        ]
      },
      "auth-legacy": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "profiles-legacy-associations": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/associations/{**catch-all}"
        }
      },
      "profiles-legacy-roles": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        }
      },
      "profiles-legacy-staff": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/staff/{**catch-all}"
        }
      },
      "profiles-legacy-users-root": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/users"
        }
      },
      "profiles-legacy-users": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "profiles-legacy-contracts": {
        "ClusterId": "profiles-cluster",
        "Match": {
          "Path": "/api/v1/contracts/{**catch-all}"
        }
      },
      "cultivation-legacy-farms": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/farms/{**catch-all}"
        }
      },
      "cultivation-legacy-zones": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/zones/{**catch-all}"
        }
      },
      "cultivation-legacy-catalog": {
        "ClusterId": "cultivation-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "profiles-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "cultivation-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*"
}
