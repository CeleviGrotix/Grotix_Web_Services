# Copiar a .env y rellenar con tus valores Azure
# cp .env.example .env

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=EstaEsUnaClaveSuperSecretaParaGrotix2024

# ── Azure Database for MySQL ──────────────────────────────────────
MYSQL_HOST=tu-servidor.mysql.database.azure.com
MYSQL_DB=grotix
MYSQL_USER=grotix
MYSQL_PASSWORD=tu-password-aqui

# Base de datos separada para crop analysis
CROP_MYSQL_DB=grotix_crop_analysis

# ── Azure Database for PostgreSQL (TimescaleDB) ───────────────────
POSTGRES_HOST=tu-servidor.postgres.database.azure.com
POSTGRES_DB=grotix_telemetry
POSTGRES_USER=grotix
POSTGRES_PASSWORD=tu-password-aqui

# ── AI Prediction Service (cuando esté dockerizado) ──────────────
AI_SERVICE_URL=http://localhost:8002

# ── RabbitMQ (opcional) ───────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
