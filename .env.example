# Local environment overrides for Grotix Web Services
# Loaded automatically before each host builds its configuration.

# Core DB
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=grotix_core;Uid=root;Pwd=CHANGE_ME;
MySql__ServerVersion=8.0.36

# Optional telemetry DB
ConnectionStrings__TelemetryTimescale=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;

# JWT / auth
TokenSettings__Secret=CHANGE_ME_SUPER_SECRET

# RabbitMQ
RabbitMq__Enabled=false
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__VirtualHost=/
RabbitMq__ExchangeName=grotix.events
RabbitMq__UserRegisteredQueueName=cultivation.user.registered
RabbitMq__UserRegisteredRoutingKey=user.registered

# Developer experience
Swagger__Enabled=true

# Local gateway destinations
ReverseProxy__Clusters__profiles-cluster__Destinations__d1__Address=http://localhost:5101/
ReverseProxy__Clusters__cultivation-cluster__Destinations__d1__Address=http://localhost:5102/
ReverseProxy__Clusters__telemetry-cluster__Destinations__d1__Address=http://localhost:5103/
ReverseProxy__Clusters__hardware-cluster__Destinations__d1__Address=http://localhost:5104/

RabbitMq__TelemetryReceivedQueueName=telemetry.received
RabbitMq__TelemetryReceivedRoutingKey=telemetry.received
RabbitMq__AlertTriggeredRoutingKey=alert.triggered
